<Window x:Class="HandModel3D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kb="clr-namespace:HandModel3D.KeyboardUi"
        Title="손 모델 3D(Hand Model 3D)" Height="880" Width="1560"
        MinHeight="620" MinWidth="1040"
        AllowDrop="True"
        FontFamily="Malgun Gothic, Segoe UI"
        Background="#FFF1F3F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목 표시줄(앱 내부) : 열기 / 저장 / 설정 / 도움말 / 정보 (<260811_32>)
             ※ DockPanel.Dock="Right" 는 먼저 선언한 것이 가장 오른쪽에 놓이므로,
                화면 순서(왼→오른)의 역순으로 적어야 한다. -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarBg}">
            <!-- <260811_20>(2-1): 버튼을 먼저 오른쪽에 도킹시켜 자리를 확보한 뒤, 제목 TextBlock 을
                 마지막(LastChildFill)으로 나머지 폭을 채우게 한다 — TextTrimming 이 남는 폭 안에서만
                 계산되어, 버튼과 겹치지 않고 길면 스스로 말줄임(...) 처리된다. -->
            <DockPanel x:Name="TitleBarPanel" LastChildFill="True" Margin="10 4">
                <Button DockPanel.Dock="Right" x:Name="InfoBtn" Style="{StaticResource TitleBarButton}" Content="정보" Click="Info_Click"/>
                <Button DockPanel.Dock="Right" x:Name="HelpBtn" Style="{StaticResource TitleBarButton}" Content="도움말" Click="Help_Click"/>
                <Button DockPanel.Dock="Right" x:Name="SettingsBtn" Style="{StaticResource TitleBarButton}" Content="설정" Click="Settings_Click"/>
                <Button DockPanel.Dock="Right" x:Name="SaveBtn" Style="{StaticResource TitleBarButton}" Content="저장" Click="Save_Click"/>
                <Button DockPanel.Dock="Right" x:Name="OpenBtn" Style="{StaticResource TitleBarButton}" Content="열기" Click="Open_Click"/>
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="손 모델 3D(Hand Model 3D)"/>
            </DockPanel>
        </Border>

        <!-- 상단 패널 -->
        <Border Grid.Row="1" Background="#FFE9ECEF" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0 0 0 1">
            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                <WrapPanel x:Name="TopWrap" Orientation="Horizontal" Margin="6 4">

                    <!-- 크기 (<260811_6>(1): 독립 패널·맨 왼쪽·세로 슬라이더, '전체' 문구 생략) -->
                    <Border Style="{StaticResource GroupBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelHeader}" Text="크기"/>
                            <!-- <260811_21>: 초기값 95%(AppSettings.DefOverallScale·HandScene.OverallScale 과 동일 상수) -->
                            <Slider x:Name="SizeSlider" Orientation="Vertical" Height="64" HorizontalAlignment="Center" Minimum="0.5" Maximum="1.8" Value="0.95"/>
                            <!-- <260811_6-1>(1): 클릭하면 숫자 입력 -->
                            <TextBlock x:Name="SizeLabel" FontSize="10" Text="95%" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 좌우 (<260811_12>: 양손의 상하 길이 대비 좌우 길이 비율) -->
                    <Border Style="{StaticResource GroupBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelHeader}" Text="좌우"/>
                            <!-- <260811_21>: 초기값 130%(AppSettings.DefWidthScale·HandScene.WidthScale 과 동일 상수) -->
                            <Slider x:Name="WidthSlider" Orientation="Vertical" Height="64" HorizontalAlignment="Center" Minimum="0.7" Maximum="1.3" Value="1.3"/>
                            <TextBlock x:Name="WidthLabel" FontSize="10" Text="130%" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 손가락 길이 (<260811_6>(2): 슬라이더별 아래 숫자 입력) -->
                    <Border Style="{StaticResource GroupBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelHeader}" Text="손가락 길이"/>
                            <StackPanel x:Name="LengthSliders" Orientation="Horizontal" Margin="0 2 0 0"/>
                        </StackPanel>
                    </Border>

                    <!-- 볼륨 (<260810_3>(1): 세로 슬라이더로 폭 축소) -->
                    <Border Style="{StaticResource GroupBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelHeader}" Text="볼륨"/>
                            <Slider x:Name="VolumeSlider" Orientation="Vertical" Height="64" HorizontalAlignment="Center" Minimum="0.6" Maximum="1.6" Value="1"/>
                            <TextBlock x:Name="VolumeLabel" FontSize="10" Text="100%" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 투명도 (<260811_10-3>: 슬라이더를 더 줄여 상단 패널 전체 상하 길이 축소) -->
                    <Border Style="{StaticResource GroupBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelHeader}" Text="투명도"/>
                            <!-- <260811_10-2>: '0%'(완전히 투명)를 슬라이더 위, '100%'(완전히 불투명)를 아래로.
                                 세로축 방향과 일치(위=투명도 최대=불투명도 0%, 아래=불투명도 100%). -->
                            <Button x:Name="FullyTranspBtn" Style="{StaticResource FlatButton}" Content="0%" FontSize="9" Padding="3 1" HorizontalAlignment="Center" Click="FullyTransparent_Click"/>
                            <Slider x:Name="TranspSlider" Orientation="Vertical" Height="34" HorizontalAlignment="Center" Minimum="0" Maximum="100" Value="0" Margin="0 2"/>
                            <Button x:Name="FullyOpaqueBtn" Style="{StaticResource FlatButton}" Content="100%" FontSize="9" Padding="3 1" HorizontalAlignment="Center" Click="FullyOpaque_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 색상 (<260810_3>(2): 예시 색 3×2, 버튼·패널 폭 축소) -->
                    <Border Style="{StaticResource GroupBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelHeader}" Text="피부색"/>
                            <UniformGrid x:Name="SkinSwatches" Columns="3" HorizontalAlignment="Left"/>
                            <Button x:Name="ColorBtn" Style="{StaticResource FlatButton}" Content="색 상세…" FontSize="10" Padding="3 2" Margin="0 2 0 0" HorizontalAlignment="Left" Click="Color_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 윤곽선 -->
                    <Border Style="{StaticResource GroupBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelHeader}" Text="윤곽선"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="OutlineShow" Content="보이기" FontSize="10" VerticalAlignment="Center" Click="Outline_Changed"/>
                                <CheckBox x:Name="OutlineOnly" Content="윤곽선만" FontSize="10" Margin="6 0 0 0" VerticalAlignment="Center" Click="Outline_Changed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 2 0 0">
                                <TextBlock Text="두께" FontSize="10" VerticalAlignment="Center"/>
                                <Slider x:Name="OutlineThick" Width="70" Minimum="1" Maximum="8" Value="2.5" VerticalAlignment="Center"/>
                                <StackPanel x:Name="OutlineSwatches" Orientation="Horizontal" Margin="4 0 0 0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 2 0 0">
                                <Button x:Name="OutlineModeBtn" Style="{StaticResource FlatButton}" Content="모드: 가림" FontSize="10" Padding="5 2" Click="OutlineMode_Click"/>
                                <Button x:Name="TipColorBtn" Style="{StaticResource FlatButton}" Content="손끝 색…" FontSize="10" Padding="5 2" Margin="4 0 0 0" Click="TipColor_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 손 회전 -->
                    <Border Style="{StaticResource GroupBox}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Style="{StaticResource PanelHeader}" Text="손 회전" DockPanel.Dock="Left"/>
                                <Button x:Name="RotResetBtn" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="0°" FontSize="9" Padding="4 1" Click="RotReset_Click"/>
                            </DockPanel>
                            <!-- <260810_5>(2): 왼손·오른손 세트를 각각 검은 선 테두리로 감싼다 -->
                            <StackPanel x:Name="RotRow" Orientation="Horizontal"/>
                        </StackPanel>
                    </Border>

                    <!-- 손 위치 (<260810_3>(7)): 방향키(양손)·[Ctrl]+한손 드래그의 '위치 이동'을 슬라이더·숫자로 제어 -->
                    <Border Style="{StaticResource GroupBox}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Style="{StaticResource PanelHeader}" Text="손 위치" DockPanel.Dock="Left"/>
                                <Button x:Name="HandPosResetBtn" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="0" FontSize="9" Padding="4 1" Click="HandPosReset_Click"/>
                            </DockPanel>
                            <Grid x:Name="HandPosGrid"/>
                        </StackPanel>
                    </Border>

                    <!-- 카메라 -->
                    <Border Style="{StaticResource GroupBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelHeader}" Text="카메라(캡처)"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="CapBoth" Content="둘 다" FontSize="10" IsChecked="True" GroupName="capT" Click="CaptureTarget_Changed"/>
                                <RadioButton x:Name="CapLeft" Content="왼손만" FontSize="10" Margin="6 0 0 0" GroupName="capT" Click="CaptureTarget_Changed"/>
                                <RadioButton x:Name="CapRight" Content="오른손만" FontSize="10" Margin="6 0 0 0" GroupName="capT" Click="CaptureTarget_Changed"/>
                            </StackPanel>
                            <Button x:Name="BitmapCamBtn" Style="{StaticResource FlatButton}" Content="비트맵 캡처(PNG)" FontSize="10" Padding="5 2" Margin="0 2 0 0" Click="BitmapCapture_Click"/>
                            <Button x:Name="VectorCamBtn" Style="{StaticResource FlatButton}" Content="벡터 캡처(SVG)" FontSize="10" Padding="5 2" Margin="0 2 0 0" Click="VectorCapture_Click"/>
                            <CheckBox x:Name="VectorFill" Content="벡터 내부 채움" FontSize="10" Margin="0 2 0 0"/>
                        </StackPanel>
                    </Border>

                    <!-- 배경 키보드 -->
                    <Border Style="{StaticResource GroupBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelHeader}" Text="배경 키보드"/>
                            <RadioButton x:Name="KbNone" Content="없음" FontSize="10" IsChecked="True" GroupName="kb" Click="Keyboard_Changed"/>
                            <RadioButton x:Name="KbDubeol" Content="두벌식 표준" FontSize="10" GroupName="kb" Click="Keyboard_Changed"/>
                            <RadioButton x:Name="KbQwerty" Content="QWERTY" FontSize="10" GroupName="kb" Click="Keyboard_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- 배경 이미지 (<260719_10>; <260810_3>(3): 지우기를 파일명 아래로, 폭 축소) -->
                    <Border Style="{StaticResource GroupBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelHeader}" Text="배경 이미지"/>
                            <Button x:Name="BgOpenBtn" Style="{StaticResource FlatButton}" Content="이미지 열기…" FontSize="10" Padding="5 2" HorizontalAlignment="Left" Click="BgImageOpen_Click"/>
                            <TextBlock x:Name="BgFileLabel" FontSize="9" Foreground="#FF495057" Text="(없음)" Margin="0 2 0 0" MaxWidth="86" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="BgClearBtn" Style="{StaticResource FlatButton}" Content="지우기" FontSize="10" Padding="5 2" Margin="0 2 0 0" HorizontalAlignment="Left" Click="BgImageClear_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 고정점 투명도 (<260810_3>(1): 세로 슬라이더로 폭 축소) -->
                    <Border Style="{StaticResource GroupBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PanelHeader}" Text="빨간 고정점"/>
                            <TextBlock Text="투명도" FontSize="10" TextAlignment="Center"/>
                            <Slider x:Name="PinOpacity" Orientation="Vertical" Height="52" HorizontalAlignment="Center" Minimum="0" Maximum="100" Value="0"/>
                            <TextBlock x:Name="PinOpacityLabel" FontSize="10" Text="0%" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </WrapPanel>
            </ScrollViewer>
        </Border>

        <!-- 작업 영역: 좌 패널 | 그래픽 | 우 패널 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                          Background="#FFF1F3F5" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0 0 1 0">
                <StackPanel x:Name="LeftPanelHost">
                    <TextBlock Style="{StaticResource PanelHeader}" Text="왼손 관절" Margin="6 4 0 0"/>
                    <StackPanel Orientation="Horizontal" Margin="4 0">
                        <Button x:Name="LeftLabelBtn" Style="{StaticResource FlatButton}" Content="표시" FontSize="10" Padding="6 2" Click="ToggleLabels_Click"/>
                        <Button x:Name="LeftLabelSizeBtn" Style="{StaticResource FlatButton}" Content="크기" FontSize="10" Padding="6 2" Margin="4 0 0 0" Click="LabelSize_Click"/>
                        <!-- <260811_18>(2) 그 손의 모든 관절을 초기값으로 -->
                        <Button x:Name="LeftJointResetBtn" Style="{StaticResource FlatButton}" Content="초기화" FontSize="10" Padding="6 2" Margin="4 0 0 0" Click="JointResetLeft_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" x:Name="GraphicsHost" Background="#FFDDE3EA" ClipToBounds="True">
                <Grid>
                    <!-- 배경 렌더링 키보드 (3-6): [Ctrl] 없이는 순수 배경 -->
                    <kb:KeyboardControl x:Name="KbControl"
                                        Visibility="Collapsed"
                                        Width="760"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5">
                        <kb:KeyboardControl.RenderTransform>
                            <ScaleTransform x:Name="KbScale" ScaleX="1" ScaleY="1"/>
                        </kb:KeyboardControl.RenderTransform>
                    </kb:KeyboardControl>
                    <!-- 배경 이미지 (<260719_10>): 키보드 위, 3D 손 아래 레이어. 캡처에는 포함되지 않음 -->
                    <Image x:Name="BgImage"
                           Visibility="Collapsed"
                           Stretch="Fill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="BgScale" ScaleX="1" ScaleY="1"/>
                        </Image.RenderTransform>
                    </Image>
                    <Image x:Name="SceneImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <!-- 라벨·빨간 고정점·xyz축 오버레이. <260811_23>: 비트맵(PNG) 캡처는 예외로
                         활성화된 빨간 고정점만 별도로 다시 그려 포함한다(MainWindow.ComputeActivePinDotsPx
                         + Capture.SaveBitmap 의 pinDots) — 이 Canvas 자체는 여전히 캡처 대상이 아니다. -->
                    <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
                    <!-- 시점 회전 패널 (<260810_3-1>(4)): 기즈모 좌표축(시점 회전)을 슬라이더·숫자로 제어.
                         기즈모 오른쪽. 캡처에는 포함되지 않음. <260811_4-1>(1): 오른쪽에 물갈퀴 살 패널 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="118 0 0 10">
                        <Border x:Name="ViewRotPanel" Padding="6 3" VerticalAlignment="Bottom"
                                Background="#B3FFFFFF" BorderBrush="#FFADB5BD" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0 0 0 2">
                                    <TextBlock Text="시점 회전" FontSize="10" FontWeight="Bold" DockPanel.Dock="Left"/>
                                    <Button x:Name="ViewRotResetBtn" DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                                            Content="0" FontSize="9" Padding="4 0" Margin="8 0 0 0" Click="ViewRotReset_Click"/>
                                </DockPanel>
                                <!-- <260810_3-2>(4): 세 슬라이더를 좌우(가로)로 배치 -->
                                <StackPanel x:Name="ViewRotRow" Orientation="Horizontal"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="WebbingPanel" Margin="8 0 0 0" Padding="6 3" VerticalAlignment="Bottom"
                                Background="#B3FFFFFF" BorderBrush="#FFADB5BD" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="물갈퀴 살" FontSize="10" FontWeight="Bold" Margin="0 0 0 2"/>
                                <StackPanel x:Name="WebbingRow" Orientation="Horizontal"/>
                            </StackPanel>
                        </Border>
                        <!-- 살 반응 (<260811_11>: 상단에서 이곳으로 이동, 좌우 슬라이더) -->
                        <Border x:Name="FleshPanel" Margin="8 0 0 0" Padding="6 3" VerticalAlignment="Bottom"
                                Background="#B3FFFFFF" BorderBrush="#FFADB5BD" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="살 반응" FontSize="10" FontWeight="Bold" Margin="0 0 0 2"/>
                                <StackPanel x:Name="FleshRow" Orientation="Horizontal"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                          Background="#FFF1F3F5" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1 0 0 0">
                <StackPanel x:Name="RightPanelHost">
                    <TextBlock Style="{StaticResource PanelHeader}" Text="오른손 관절" Margin="6 4 0 0"/>
                    <StackPanel Orientation="Horizontal" Margin="4 0">
                        <Button x:Name="RightLabelBtn" Style="{StaticResource FlatButton}" Content="표시" FontSize="10" Padding="6 2" Click="ToggleLabels_Click"/>
                        <Button x:Name="RightLabelSizeBtn" Style="{StaticResource FlatButton}" Content="크기" FontSize="10" Padding="6 2" Margin="4 0 0 0" Click="LabelSize_Click"/>
                        <!-- <260811_18>(2) 그 손의 모든 관절을 초기값으로 -->
                        <Button x:Name="RightJointResetBtn" Style="{StaticResource FlatButton}" Content="초기화" FontSize="10" Padding="6 2" Margin="4 0 0 0" Click="JointResetRight_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 상태 표시줄 (<260811_14-1>: 두께가 변해도 배경 키보드·배경 이미지·3D 손은 안 움직인다) -->
        <Border Grid.Row="3" x:Name="StatusBar" Background="#FFE9ECEF" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0 1 0 0">
            <ItemsControl x:Name="StatusList" Margin="8 4"/>
        </Border>
    </Grid>
</Window>
